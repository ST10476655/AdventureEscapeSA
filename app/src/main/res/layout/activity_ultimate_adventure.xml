<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECECEC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="90dp"
            android:background="#5AA5F5"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/logo"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Ultimate Adventure Day"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_sort_by_size"/>

        </LinearLayout>

        <!-- PACKAGE IMAGE -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/hero_height"
            android:scaleType="centerCrop"
            android:src="@drawable/ultimate_adventure_day"/>

        <!-- INFORMATION CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="#5AA5F5"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ultimate Adventure Day"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#2E8B57"/>

            <!-- PRICE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Price"
                android:textStyle="bold"
                android:textColor="#444444"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R1500"
                android:textColor="#444444"/>

            <!-- PURPOSE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Purpose"
                android:textStyle="bold"
                android:textColor="#444444"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="A full-day outdoor adventure featuring multiple exciting activities and unforgettable experiences."
                android:textColor="#444444"/>

            <!-- INCLUDES -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Includes"
                android:textStyle="bold"
                android:textColor="#444444"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Guided Hiking Trail&#10;• Ziplining&#10;• Kayaking&#10;• Lunch&#10;• Safety Briefing And Equipment"
                android:textColor="#444444"/>

        </LinearLayout>

        <!-- BOOK NOW BUTTON -->

        <Button
            android:id="@+id/btnBookNow"
            android:layout_width="@dimen/button_width"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_gravity="center"
            android:text="Book Now"
            android:textColor="#2E8B57"
            android:backgroundTint="#FF8C42"/>

        <!-- REQUEST QUOTE BUTTON -->

        <Button
            android:id="@+id/btnQuote"
            android:layout_width="@dimen/button_width"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:text="Request Quote"
            android:textColor="#2E8B57"
            android:backgroundTint="#FF8C42"/>

        <!-- BACK BUTTON -->

        <Button
            android:id="@+id/btnBack"
            android:layout_width="@dimen/button_width"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:text="Back"
            android:textColor="#2E8B57"
            android:backgroundTint="#FF8C42"/>

    </LinearLayout>

</ScrollView>