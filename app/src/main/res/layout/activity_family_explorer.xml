<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECECEC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="#5AA5F5"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/logo"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Family Explorer Package"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_sort_by_size"
                tools:ignore="TouchTargetSizeCheck" />

        </LinearLayout>

        <!-- PACKAGE IMAGE -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:src="@drawable/family_explorer"/>

        <!-- INFORMATION CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="#5AA5F5"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Family Explorer Package"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#2E8B57"/>

            <!-- PRICE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Price"
                android:textStyle="bold"
                android:textColor="#444444"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R1500"
                android:textColor="#444444"/>

            <!-- PURPOSE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Purpose"
                android:textStyle="bold"
                android:textColor="#444444"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="A fun-filled outdoor experience designed especially for families."
                android:textColor="#444444"/>

            <!-- INCLUDES -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Includes"
                android:textStyle="bold"
                android:textColor="#444444"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Nature Walk&#10;• Obstacle Course&#10;• Picnic Area&#10;• Family Games&#10;• Guided Wildlife Spotting"
                android:textColor="#444444"/>

        </LinearLayout>

        <!-- BOOK NOW -->

        <Button
            android:id="@+id/btnBookNow"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:backgroundTint="#FF8C42"
            android:text="Book Now"
            android:textColor="#2E8B57" />

        <!-- REQUEST QUOTE -->

        <Button
            android:id="@+id/btnQuote"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:backgroundTint="#FF8C42"
            android:text="Request Quote"
            android:textColor="#2E8B57" />

        <!-- BACK BUTTON -->

        <Button
            android:id="@+id/btnBack"
            android:layout_width="220dp"
            android:layout_height="45dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:text="Back"
            android:textColor="#2E8B57"
            android:backgroundTint="#FF8C42"/>

    </LinearLayout>

</ScrollView>