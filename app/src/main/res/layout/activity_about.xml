<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECECEC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="#5AA5F5"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:contentDescription="TODO"
                android:src="@drawable/logo"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="@string/about_us"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="TODO"
                android:src="@android:drawable/ic_menu_sort_by_size"/>

        </LinearLayout>

        <!-- IMAGE -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:contentDescription="TODO"
            android:src="@drawable/about_us"
            android:scaleType="centerCrop"/>

        <!-- INFO CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="#5AA5F5"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/history"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2E8B57"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/adventure_escape_sa_was_established_to_provide_exciting_outdoor_experiences_for_families_tourists_schools_and_corporate_groups"
                android:textColor="#444444"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/vision"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2E8B57"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/to_become_south_africa_s_leading_adventure_tourism_provider"
                android:textColor="#444444"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/mission"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2E8B57"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/to_provide_safe_memorable_and_environmentally_responsible_outdoor_adventures"
                android:textColor="#444444"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/goals"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2E8B57"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/promote_eco_tourism_10_encourage_outdoor_activities_10_foster_teamwork_10_create_memorable_experiences"
                android:textColor="#444444"/>

        </LinearLayout>

        <!-- BACK BUTTON -->

        <Button
            android:id="@+id/btnBack"
            android:layout_width="180dp"
            android:layout_height="45dp"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:text="Back"
            android:textColor="#2E8B57"
            android:backgroundTint="#FF8C42"/>

    </LinearLayout>

</ScrollView>